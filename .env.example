TELEGRAM_BOT_TOKEN=REPLACE_ME
BOT_NAME=
BOT_ALIASES=
GROUP_ALLOWED_CHATS=
# Forum topics, as chat_id:message_thread_id pairs (e.g. -1003765317870:42).
# A chat with no pair listed is unrestricted.
GROUP_ALLOWED_TOPICS=
ALLOWED_USERS=
PERSONA_FILE=
OPENROUTER_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
TAVILY_API_KEY=REPLACE_ME
BRAVE_API_KEY=REPLACE_ME
DATABASE_URL=postgresql+psycopg://bot:bot@db:5432/bot
# Hermes-agent sidecar. HERMES_API_KEY (bot side) must equal API_SERVER_KEY
# (hermes side). Generate with: openssl rand -hex 32 (must be >=16 chars or
# the api_server refuses to start).
HERMES_URL=http://hermes:8642
HERMES_API_KEY=REPLACE_ME
API_SERVER_KEY=REPLACE_ME
API_SERVER_ENABLED=1
MCP_TOOLS_URL=http://mcp-tools:8000
